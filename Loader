local function DoLaunch(entry)
    SetStatus("launching...", Theme.Warning)
    Toast("launching " .. entry.name:lower() .. "...", Theme.Warning, 2)

    Tween(LaunchBtn, 0.08, { Size = UDim2.new(1, -36, 0, 44) })
    task.delay(0.1, function()
        Tween(LaunchBtn, 0.12, { Size = UDim2.new(1, -28, 0, 46) })
    end)

    task.delay(0.3, function()
        local ok, err = pcall(entry.action)
        if ok then
            SetStatus("loaded ✓", Theme.Success)
            Toast(entry.name .. " loaded", Theme.Success)
