-- ═══════════════ OPEN / HIDE / UNLOAD ═══════════════
-- HideShow: toggles visibility WITHOUT unloading
-- UnloadFull: destroys everything (× button only)

local IsOpen = false
local Connections = {}

local function TrackConn(conn)
    table.insert(Connections, conn)
    return conn
end

local function UnloadFull()
    for _, conn in ipairs(Connections) do
        if conn.Connected then
            conn:Disconnect()
        end
    end

    if isfolder and isfile then
        for _, entry in ipairs(LaunchList) do
            if entry.gameId and entry.gameId > 0 then
                local fileName = "nyx_icon_" .. tostring(entry.gameId) .. ".png"
                if isfile(fileName) then
                    delfile(fileName)
                end
            end
        end
    end

    Gui:Destroy()
    print("[nyx] launcher unloaded")
end

-- full open (first time or after show)
local function Open()
    IsOpen = true
    Main.Visible = true
    Main.BackgroundTransparency = 1
    Main.Size = UDim2.new(0, 390, 0, 370)
    Main.Rotation = 1.5

    for _, card in pairs(Cards) do
        card.frame.Visible = false
    end

    Tween(Main, 0.45, { BackgroundTransparency = 0, Size = UDim2.new(0, 420, 0, 400), Rotation = 0 }, Enum.EasingStyle.Back)

    task.delay(0.15, function()
        for i, card in pairs(Cards) do
            task.delay(i * 0.1, function()
                if card.frame.Parent then
                    card.frame.Visible = true
                    card.frame.BackgroundTransparency = 1
                    card.frame.Size = UDim2.new(1, -20, 0, 68)
                    Tween(card.frame, 0.3, { BackgroundTransparency = 0, Size = UDim2.new(1, -8, 0, 68) }, Enum.EasingStyle.Back)
                end
            end)
        end
    end)

    task.delay(0.2, function()
        local fullTitle = "nyx launcher"
        for j = 1, #fullTitle do
            Title.Text = fullTitle:sub(1, j)
            task.wait(0.03)
        end
        task.delay(0.15, function()
            local fullSub = "nyx launcher // Werxa"
            for j = 1, #fullSub do
                Subtitle.Text = fullSub:sub(1, j)
                task.wait(0.015)
            end
        end)
    end)
end

-- simple show (already initialized, just unhide)
local function Show()
    IsOpen = true
    Main.Visible = true
    Main.BackgroundTransparency = 1
    Tween(Main, 0.3, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quart)
end

-- simple hide (keeps everything alive)
local function Hide()
    IsOpen = false
    HideConfirm()
    Tween(Main, 0.2, { BackgroundTransparency = 1 })
    task.delay(0.25, function()
        if not IsOpen then
            Main.Visible = false
        end
    end)
end

-- full close with unload (× button)
local function CloseAndUnload()
    IsOpen = false
    HideConfirm()

    for i, card in pairs(Cards) do
        task.delay((#Cards - i) * 0.03, function()
            if card.frame.Parent then
                Tween(card.frame, 0.12, { BackgroundTransparency = 1, Size = UDim2.new(1, -16, 0, 68) })
            end
        end)
    end

    task.delay(0.1, function()
        Tween(Main, 0.25, { BackgroundTransparency = 1, Size = UDim2.new(0, 395, 0, 380), Rotation = -1.5 })
        task.delay(0.3, function()
            UnloadFull()
        end)
    end)
end

-- × button = full unload
TrackConn(CloseBtn.MouseButton1Click:Connect(function()
    Ripple(CloseBtn)
    CloseAndUnload()
end))

-- RightShift = hide/show only
TrackConn(UserInputService.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.RightShift then
        if IsOpen then
            Hide()
        else
            Show()
        end
    end
end))

-- ═══════════════ DRAG ═══════════════
do
    local dragging, dragStart, startPos

    TrackConn(Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
        end
    end))

    TrackConn(UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end))

    TrackConn(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end))
end

