-- ═══════════════ HELPERS ═══════════════
local function Create(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        inst[k] = v
    end
    return inst
end

local function Tween(obj, time, props, style, dir)
    TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props):Play()
end

local function Corner(parent, r)
    Create("UICorner", { Parent = parent, CornerRadius = UDim.new(0, r or 8) })
end

local function Stroke(parent, color, thickness, transparency)
    return Create("UIStroke", { Parent = parent, Color = color or Theme.Stroke, Thickness = thickness or 1, Transparency = transparency or 0 })
end

local function Gradient(parent, c1, c2, rot)
    return Create("UIGradient", { Parent = parent, Rotation = rot or 90, Color = ColorSequence.new(c1, c2) })
end

local function Ripple(frame)
    local circle = Create("Frame", {
        Parent = frame,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 0.85,
        BorderSizePixel = 0,
        ZIndex = 50,
    })
    Corner(circle, 100)
    local target = math.max(frame.AbsoluteSize.X, frame.AbsoluteSize.Y) * 2.2
    Tween(circle, 0.45, { Size = UDim2.new(0, target, 0, target), BackgroundTransparency = 1 }, Enum.EasingStyle.Quart)
    task.delay(0.5, function() circle:Destroy() end)
end

-- ═══════════════ ICON LOADER ═══════════════
local function GetGameIcon(gameId)
    if not gameId or gameId <= 0 then return nil end

    local ok, iconUrl = pcall(function()
        local raw = game:HttpGet(
            "https://thumbnails.roblox.com/v1/places/gameicons?placeIds=" .. tostring(gameId) .. "&size=150x150&format=Png&isCircular=false"
        )
        local data = HttpService:JSONDecode(raw)
        if data and data.data and data.data[1] and data.data[1].state == "Completed" and data.data[1].imageUrl then
            return data.data[1].imageUrl
        end
        return nil
    end)
    if not ok or not iconUrl then return nil end

    local ok2, imgData = pcall(function()
        return game:HttpGet(iconUrl)
    end)
    if not ok2 or not imgData or #imgData < 100 then return nil end

    if writefile and getcustomasset then
        local fileName = "nyx_icon_" .. tostring(gameId) .. ".png"
        writefile(fileName, imgData)
        return getcustomasset(fileName)
    end

    return nil
end

