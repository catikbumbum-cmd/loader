local function Toast(text, color, duration)
    ToastOrder += 1
    local toast = Create("Frame", {
        Parent = ToastHolder,
        Size = UDim2.new(0, 250, 0, 36),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        ZIndex = 100,
        LayoutOrder = ToastOrder,
    })
    Corner(toast, 10)
    local ts = Stroke(toast, color or Theme.Accent, 1)

    Create("Frame", {
        Parent = toast,
        Position = UDim2.new(0, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        Size = UDim2.new(0, 3, 0, 20),
        BackgroundColor3 = color or Theme.Accent,
        BorderSizePixel = 0,
    })

    Create("TextLabel", {
        Parent = toast,
        Position = UDim2.new(0, 12, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        Size = UDim2.new(1, -24, 0, 14),
        BackgroundTransparency = 1,
        Text = text,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    toast.BackgroundTransparency = 1
    ts.Transparency = 1
    Tween(toast, 0.3, { BackgroundTransparency = 0 })
    Tween(ts, 0.3, { Transparency = 0 })

    task.delay(duration or 3, function()
        Tween(toast, 0.3, { BackgroundTransparency = 1, Position = toast.Position + UDim2.new(0, 20, 0, 0) })
        Tween(ts, 0.3, { Transparency = 1 })
        task.delay(0.35, function() toast:Destroy() end)
    end)
end

